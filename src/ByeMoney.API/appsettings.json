  "STRAPI_TO_BYEMONEY_SERVICE_KEY": "",
  "FRONTEND_TO_BYEMONEY_SERVICE_KEY": "",
  "Strapi": {
    "JwtIssuer": "tarhelahi-strapi",
    "JwtAudience": "byemoney"
  }
}